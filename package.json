{
  "name": "@awaymess/ui",
  "version": "0.1.21",
  "description": "Custom MUI UI Component Library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaymess/nighttt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/awaymess/nighttt-ui/issues"
  },
  "homepage": "https://github.com/awaymess/nighttt-ui#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "tsc"
  },
  "dependencies": {
    "@emotion/react": ">=11.14.0",
    "@emotion/styled": ">=11.14.1",
    "@mui/icons-material": ">=9.2.0",
    "@mui/material": ">=9.2.0",
    "@mui/x-date-pickers": ">=9.8.0",
    "react-number-format": "^5.4.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.8.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
